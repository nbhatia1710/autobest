# AutoBest Motors Backend Environment Configuration Template
# Copy this file to .env for local development or set these variables in your deployment environment.

# Server Environment (development | production | test)
NODE_ENV=development

# Server HTTP Port
PORT=8000

# JSON Web Token Secret
# REQUIRED in production: Must be a cryptographically strong secret of at least 32 characters.
# In development only, a default fallback is permitted.
JWT_SECRET=replace-with-a-cryptographically-random-32-plus-char-secret-key

# JWT Token Expiry (e.g., 24h, 7d)
JWT_EXPIRES_IN=24h

# SQLite Database Storage File Path (relative to backend root or absolute)
DATABASE_PATH=data/autobest.sqlite

# CORS Allowed Origins (comma-separated browser origins)
# In production, specify the exact domain(s) hosting your frontend application.
# Example: CORS_ORIGIN=https://autobest.example.com,https://admin.autobest.example.com
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Initial Administrator Credentials (Optional)
# In production:
# - Leave blank if you prefer to seed administrators manually via database script.
# - If provided, ADMIN_PASSWORD must be at least 12 characters and MUST NOT use published sample passwords.
ADMIN_EMAIL=admin@autobest.com
ADMIN_PASSWORD=SetSecureProductionPassword123!
